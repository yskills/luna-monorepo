# Kopieren nach deploy/.env (git-ignored) und ausfüllen.

# Deine Domain für HTTPS, z. B. meine-luna.duckdns.org
LUNA_DOMAIN=

# Login: `docker compose run --rm luna node scripts/set-password.mjs --print` gibt beide Zeilen aus.
LUNA_ADMIN_PASSWORD_HASH=
LUNA_SESSION_SECRET=
LUNA_SESSION_TTL_DAYS=30

# Lokales Modell (läuft im ollama-Container), z. B. ein kleines Modell für die CPU
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b

ASSISTANT_FORCE_CHARACTER_ID=luna
ASSISTANT_MODE_CONFIG_FILE=../../packages/assistant-core/config/assistant-mode-config.example.json

# Optionales Passwort für den Secret-Mode
ASSISTANT_UNCENSORED_PASSWORD=

ASSISTANT_WEB_SEARCH_ENABLED=true
ASSISTANT_WEB_SEARCH_CHARACTERS=luna

# Cockpit
LUNA_LANGUAGE=de
LUNA_TIMEZONE=Europe/Berlin
LUNA_BRIEFING_TIME=07:00

# Outlook (optional, read-only), see DEPLOY-DE.md step 5
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=
LUNA_TOKEN_KEY=

# TikTok (optional, read-only), see DEPLOY-DE.md step 6
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
