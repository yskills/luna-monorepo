HOST=127.0.0.1
PORT=5050

# --------------------------------------------
# Login (Pflicht). Nie committen: .env ist git-ignored.
# `npm run set-password` fragt das Passwort verdeckt ab
# und schreibt nur den scrypt-Hash + ein Session-Secret hierher.
# --------------------------------------------
LUNA_ADMIN_PASSWORD_HASH=
LUNA_SESSION_SECRET=
# Tage, die ein Gerät eingeloggt bleibt
LUNA_SESSION_TTL_DAYS=30
# Lokal ohne HTTPS: false. Auf dem Server (HTTPS) automatisch true über NODE_ENV=production.
# LUNA_COOKIE_SECURE=false
# Nur lokal zum Entwickeln, in Produktion verboten:
# LUNA_AUTH_DISABLED=true

# Hinter Caddy/Cloudflare: Anzahl Proxy-Hops, damit Rate-Limits die echte IP sehen.
# TRUST_PROXY=1

# Optional: Bearer-Key für Server-zu-Server-Jobs (nie ins Frontend!)
ASSISTANT_API_KEY=

# Trainings-Endpoints (starten lokale Prozesse). Standard: aus.
# ASSISTANT_TRAINING_API_ENABLED=true

ASSISTANT_MODE_CONFIG_FILE=./config/assistant-mode-config.local.json
ASSISTANT_MEMORY_FILE=./data/assistant-memory.sqlite

# --------------------------------------------
# LLM Profil A (lokal): Ollama
# --------------------------------------------
LLM_PROVIDER=ollama
LLM_MODEL=luna:latest
OLLAMA_HOST=http://127.0.0.1:11434
# Local model used when the routed provider fails (and for local-only modes).
# Per mode/character routing lives in the mode config under "llmRouting".
LLM_FALLBACK_MODEL=luna:latest
# Qwen3.5 thinks before answering unless this stays false (faster replies).
# LLM_THINK=false
# Only needed if a route uses the anthropic provider (key stays here, never in config).
# ANTHROPIC_API_KEY=

# --------------------------------------------
# Luna's own content filter (local guard models, see contentPolicy in the mode config)
# Text guard: llama-guard (ollama pull llama-guard3:1b), shieldgemma, or off
# --------------------------------------------
ASSISTANT_TEXT_GUARD=llama-guard
ASSISTANT_TEXT_GUARD_MODEL=llama-guard3:1b
# Image guard: ollama-vision (a local vision model), http (your own endpoint), or off
ASSISTANT_IMAGE_GUARD=ollama-vision
ASSISTANT_IMAGE_GUARD_MODEL=huihui_ai/qwen3.5-abliterated:9b-q4_K
# ASSISTANT_IMAGE_GUARD_URL=http://127.0.0.1:8090/classify

# --------------------------------------------
# Images: local ComfyUI (any checkpoint/workflow, set per character in the mode config)
# --------------------------------------------
COMFYUI_URL=http://127.0.0.1:8188
# Folder with your own API-format workflows (wins over the bundled ones)
# ASSISTANT_COMFY_WORKFLOW_DIR=./config/comfyui
# Face reference images for each character, e.g. ./data/image-references/luna/face-front.png
# ASSISTANT_IMAGE_REFERENCE_DIR=./data/image-references
# Optional hosted provider (never used in uncensored/adult mode)
# IMAGE_API_BASE_URL=https://api.openai.com/v1
# IMAGE_API_KEY=
# IMAGE_API_MODEL=gpt-image-1

# --------------------------------------------
# LLM Profil B (Hosting): OpenAI-kompatibel
# Render nutzt typischerweise dieses Profil.
# Für OpenAI:
#   OPENAI_BASE_URL=https://api.openai.com/v1
# Für OpenRouter:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
# --------------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=

# Optionaler Fallback-Modelname
# OPENAI_MODEL=gpt-4o-mini

# Optional: Retry/Backoff bei 429/5xx (OpenAI-kompatibel)
# ASSISTANT_OPENAI_RETRY_ATTEMPTS=3
# ASSISTANT_OPENAI_RETRY_BASE_DELAY_MS=1200
# ASSISTANT_OPENAI_RETRY_MAX_DELAY_MS=10000
# ASSISTANT_OPENAI_MIN_INTERVAL_MS=1200

ASSISTANT_FORCE_CHARACTER_ID=luna
# Optionales zweites Passwort für den Secret-Mode
ASSISTANT_UNCENSORED_PASSWORD=

ASSISTANT_WEB_SEARCH_ENABLED=true
ASSISTANT_WEB_SEARCH_CHARACTERS=luna
ASSISTANT_WEB_SEARCH_MAX_ITEMS=3
ASSISTANT_WEB_SEARCH_TIMEOUT_MS=9000
