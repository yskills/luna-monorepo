HOST=127.0.0.1
PORT=5050

# --------------------------------------------
# Login (Pflicht). Nie committen: .env ist git-ignored.
# `npm run set-password` fragt das Passwort verdeckt ab
# und schreibt nur den scrypt-Hash + ein Session-Secret hierher.
# --------------------------------------------
LUNA_ADMIN_PASSWORD_HASH=
LUNA_SESSION_SECRET=
# Tage, die ein Gerät eingeloggt bleibt
LUNA_SESSION_TTL_DAYS=30
# Lokal ohne HTTPS: false. Auf dem Server (HTTPS) automatisch true über NODE_ENV=production.
# LUNA_COOKIE_SECURE=false
# Nur lokal zum Entwickeln, in Produktion verboten:
# LUNA_AUTH_DISABLED=true

# Hinter Caddy/Cloudflare: Anzahl Proxy-Hops, damit Rate-Limits die echte IP sehen.
# TRUST_PROXY=1

# Optional: Bearer-Key für Server-zu-Server-Jobs (nie ins Frontend!)
ASSISTANT_API_KEY=

# Trainings-Endpoints (starten lokale Prozesse). Standard: aus.
# ASSISTANT_TRAINING_API_ENABLED=true

ASSISTANT_MODE_CONFIG_FILE=./config/assistant-mode-config.local.json
ASSISTANT_MEMORY_FILE=./data/assistant-memory.sqlite

# --------------------------------------------
# LLM Profil A (lokal): Ollama
# --------------------------------------------
LLM_PROVIDER=ollama
LLM_MODEL=luna:latest
OLLAMA_HOST=http://127.0.0.1:11434

# --------------------------------------------
# LLM Profil B (Hosting): OpenAI-kompatibel
# Render nutzt typischerweise dieses Profil.
# Für OpenAI:
#   OPENAI_BASE_URL=https://api.openai.com/v1
# Für OpenRouter:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
# --------------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=

# Optionaler Fallback-Modelname
# OPENAI_MODEL=gpt-4o-mini

# Optional: Retry/Backoff bei 429/5xx (OpenAI-kompatibel)
# ASSISTANT_OPENAI_RETRY_ATTEMPTS=3
# ASSISTANT_OPENAI_RETRY_BASE_DELAY_MS=1200
# ASSISTANT_OPENAI_RETRY_MAX_DELAY_MS=10000
# ASSISTANT_OPENAI_MIN_INTERVAL_MS=1200

ASSISTANT_FORCE_CHARACTER_ID=luna
# Optionales zweites Passwort für den Secret-Mode
ASSISTANT_UNCENSORED_PASSWORD=

ASSISTANT_WEB_SEARCH_ENABLED=true
ASSISTANT_WEB_SEARCH_CHARACTERS=luna
ASSISTANT_WEB_SEARCH_MAX_ITEMS=3
ASSISTANT_WEB_SEARCH_TIMEOUT_MS=9000

# Cockpit (dashboard, lists, money, briefing)
LUNA_DB_FILE=./data/luna.sqlite
LUNA_LANGUAGE=de
LUNA_TIMEZONE=Europe/Berlin
# Daily briefing time (HH:MM) or "off"
LUNA_BRIEFING_TIME=07:00
# Optional: model for the briefing text (defaults to LLM_MODEL); without a model a plain text is used
# LUNA_BRIEFING_MODEL=
